# Copie para .env e ajuste. O .env fica fora do git.
# O prefixo VITE_ é obrigatório: sem ele a variável não chega no código do navegador.
#
# ATENÇÃO: o Vite injeta estes valores em tempo de BUILD, não em runtime. Configurar a
# variável no painel do host depois de publicar não muda nada — é preciso refazer o deploy.

# Onde a API Spring Boot responde. Em produção, configure esta mesma variável no
# painel do serviço de hospedagem (Vercel/Netlify), com a URL pública da API.
VITE_API_URL=http://localhost:8081

# Endereço público deste site, sem barra no fim. Usado só pra montar as URLs absolutas
# das meta tags de compartilhamento (og:image / og:url) — sem ele, o link enviado no
# WhatsApp aparece sem a imagem de prévia. Em desenvolvimento pode ficar vazio.
VITE_SITE_URL=
